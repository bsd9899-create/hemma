# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضع أي قيمة سرية
# مباشرة في الكود أو تُدرجها في Git — .env مستثنى في .gitignore.
#
# المتغيرات بادئتها EXPO_PUBLIC_ لأنها تُضمَّن في حزمة التطبيق نفسها
# (يجب أن تكون قيمًا آمنة للنشر العلني فقط — مثل anon key العام لـ
# Supabase الذي يعتمد أمانه على RLS، وليس على إخفائه).

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- RevenueCat ----
# مفتاح SDK **العام** لآبل فقط — يبدأ بـ appl_
# موضعه: RevenueCat Dashboard → Project Settings → API Keys → App-specific
#         → المفتاح تحت تطبيق App Store (Public SDK Key)
#
# ⚠️ ليس مفتاح REST السري (يبدأ بـ sk_). لصقه هنا يشحنه داخل حزمة
#    التطبيق حيث يُستخرَج، فيملك المستخرِج صلاحية التعديل على اشتراكات
#    كل المستخدمين. الكود يرفض شكل المفتاح السري ويعطّل الاشتراكات بدل
#    استعماله، لكن لا تعتمد على ذلك — الصق العام.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
